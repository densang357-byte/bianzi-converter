{
  "schema": "epub-vertical-template/v1",
  "id": "zh-hant-vertical-default",
  "name": "中文 EPUB 默認豎排模版",
  "version": "1.1.2",
  "stylesheet": "default.css",
  "stylesheetSHA256": "03dbad15ef512c8c81a1631f45dc10b42d75836ab0650241ff901a73cdf396b3",
  "approvedDate": "2026-10-18",
  "layout": {
    "epubVersion": "3.0",
    "language": "zh-Hant",
    "writingMode": "vertical-rl",
    "pageProgressionDirection": "rtl",
    "bodyFont": "serif",
    "bodySizeEm": 1,
    "lineHeight": 1.7,
    "firstLineIndentEm": 2,
    "preserveExistingIndent": true,
    "chapterFont": "sans-serif",
    "chapterSizeEm": 1.3,
    "poetryFont": "cursive",
    "poetryColor": "#00008b",
    "shortNumeralsCombine": true,
    "notes": {
      "fontSizeEm": 0.8,
      "preserveVerbatimSourceText": true,
      "preserveBacklinks": true
    },
    "images": {
      "noteMarkerSizeEm": 0.8,
      "noteMarkerSizing": "relative-to-surrounding-text",
      "noteMarkerDetection": "sup/a、註釋語義屬性、noteref／footnote 類與錨點；不憑原圖像素大小把插圖當圖標",
      "keepIllustrationsAndCovers": true,
      "imageOnlyPages": "horizontal-tb"
    }
  },
  "punctuation": {
    "rulesVersion": "vertical-layout-v1",
    "quotes": "「」『』",
    "chineseParentheses": "（）",
    "chineseEllipsis": "……",
    "preserveEnglishApostropheURLsAndCode": true,
    "normalizeChineseContextHalfwidthPunctuation": true,
    "normalizeOnlyUnambiguousSentenceFinalDots": true,
    "keepAndFlagIntraChineseDots": true,
    "verbatimSourceNotes": "保留原字，以呈現層顯示直排標點",
    "stableVerticalGlyphs": {
      "…": "︙",
      "—": "︱"
    },
    "sourceTextPreservedInPresentation": true,
    "baselineAlignment": "central (middle minus half an ex)"
  },
  "integrity": {
    "separateOutput": true,
    "preserveOriginalFiles": true,
    "preserveArchivePathsAndAssets": true,
    "preserveSpineOrderAndLinks": true,
    "transformEachPartOnceDespiteManifestAliases": true,
    "recordPunctuationOffsetsAndHashes": true,
    "compareAllBodyTextAfterRecordedEdits": true,
    "validateZipXmlManifestSpineResourcesAndLinks": true,
    "reportHumanReviewScope": true
  },
  "diagnostics": {
    "stage": "layout",
    "directory": "轉換問題收集/layout",
    "uniqueRunIdPerBook": true,
    "recordTemplateVersionAndHashes": true,
    "doNotRerunConversionForLayoutOnly": true,
    "doNotOverwriteNativeAnnotations": true
  }
}
