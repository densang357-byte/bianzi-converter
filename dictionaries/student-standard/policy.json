  "pending": [
    {
      "id": "mian",
      "forms": "麫麪麵",
      "reason": "文章對古籍及臺灣表列麫，對通用規範對照列麪。轉錄主頭已成黑方塊；正文提示右旁應作丏。麫、麪的確切碼位與字體形態須核原書，暫不自行二選一。"
    },
    {
      "id": "bao",
      "forms": "襃褎褒",
      "reason": "文章先列襃對褒，後列褎對褒；轉錄褎條兼有衣袂及衣服盛貌，附錄褒的說明亦可能已合碼。不可把褎的袖義全部改成襃。"
    },
    {
      "id": "ku",
      "forms": "絝袴褲",
      "reason": "文章對通用規範繁體對照列絝對褲，對臺灣表列袴對褲。同一現代字對應兩個學生字形，須核各自釋義、書影及適用範圍，暫不指定唯一正字。"
    },
    {
      "id": "xiu",
      "forms": "繡綉銹鏽",
      "reason": "原表同時有繡對綉、繡對銹。轉錄另有獨立鏽條釋金屬氧化物，繡條釋絲繡；繡對銹先列原表疑點，不據此混合刺繡與鏽蝕。"
    },
    {
      "id": "zhi-qi",
      "forms": "衹祇祗只隻",
      "reason": "衹對祇的比較與文章限制副詞用祇的附註須分別核義；不能生成衹、祇、祗、只、隻全組互換。"
    },
    {
      "id": "nai-ni",
      "forms": "嬭妳",
      "reason": "文章單列嬭對妳，現有嬭、奶釋文主要涉及乳母與乳汁，尚未支持第二人稱的用字規則。"
    },
    {
      "id": "jian",
      "forms": "檢撿",
      "reason": "附錄撿釋同檢，主條檢可核到書署、檢制、查驗；現代撿拾等用途須另核，不把相反方向或所有檢字當作可互換。"
    },
    {
      "id": "zha",
      "forms": "札扎",
      "reason": "文章既列札對扎，又列札對札、扎。這是比較表層次的多對應，不直接推出駐扎、札記等所有詞同規則。"
    },
    {
      "id": "ye",
      "forms": "曳拽",
      "reason": "原文既列曳對拽，又列曳對拽、曳，須按讀音與動詞義項核對。"
    },
    {
      "id": "shou",
      "forms": "摔甩",
      "reason": "文章以摔對甩、摔；須拆甩出、摔倒等實際義項，不能按並列字形生成單字替換。"
    },
    {
      "id": "bing-codepoints",
      "forms": "併倂並并",
      "reason": "轉錄出現主條併及附錄併，而附錄又釋俗倂字，顯示原碼位可能已被合併。"
    },
    {
      "id": "missing-heads",
      "forms": "■與缺字構形",
      "reason": "公開舊轉錄仍有黑方塊、構形描述與缺失的字頭。僅在完整字頭查不到某字，不等於原書未收。"
    },
    {
      "id": "article-normalization",
      "forms": "敎教靑青冊册簡𥳑",
      "reason": "文章自述做過古籍規範字形調整；與字典原用字應分層。當前轉錄可見敎、青、冊、簡，不能把各層全部當作原書實物碼位。"
    }
