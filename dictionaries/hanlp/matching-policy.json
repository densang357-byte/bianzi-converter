    "于的拆分排除單于及既有複姓",
    "nl 不全類改成 nd 或 n"
  ],
  "noun_compounds": [
    {
      "source": "三才",
      "target": "三才",
      "pos": "n",
      "input_pos": [
        "m",
        "d",
        "n",
        "nz"
      ],
      "sense": "辭典收錄的天、地、人等名詞性概念；才不是時間副詞纔。只合併完整外部詞界，不加入小說招式全名。"
    }
  ],
  "modifier_compounds": [
    {
      "source": "辟邪",
      "target": "辟邪",
      "head_pos": "v",
      "tail_pos": "n",
      "noun_heads": [
        "剑",
        "劍",
